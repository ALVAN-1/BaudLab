{
  "name": "serial-protocol-manager",
  "version": "1.0.1",
  "description": "串口协议管理工具 - Electron + Vue 3 版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "dev": "vite build && electron . --dev",
    "build:vue": "vite build",
    "build": "vite build && electron-builder --win nsis",
    "build:dir": "vite build && electron-builder --win dir",
    "rebuild": "electron-rebuild",
    "test:updates": "node --test tests/update-controller.test.js"
  },
  "author": "Serial Protocol Manager",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.2.2",
    "vue": "^3.5.41"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.8.9",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "com.serial-protocol-manager",
    "productName": "BaudLab",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN"
    ],
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "update-controller.js",
      "preload.js",
      "auth.js",
      "ai-assistant.js",
      "ai-tools.js",
      "mcp-bridge.js",
      "frame-codec.js",
      "db-schema.js",
      "default-protocol-data.js",
      "assets/**/*",
      "dist/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico",
      "executableName": "Serial Protocol Manager"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BaudLab-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "differentialPackage": false,
      "warningsAsErrors": false,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeader": "build/header.bmp",
      "installerHeaderIcon": "assets/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "ALVAN-1",
      "repo": "BaudLab.io"
    }
  }
}
